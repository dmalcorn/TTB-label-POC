# TTB COLA Label Specialist POC — environment configuration.
# Copy to `.env` and fill in. Every variable is OPTIONAL: absent keys leave the
# feature off (AR-9). With nothing set, the app boots OCR-only with zero egress.

# --- Access gate (Story 1.5) -------------------------------------------------
# Shared token required to reach the demo. Absent ⇒ gate not enforced yet.
ACCESS_TOKEN=

# --- LLM layer (Story 2.5, toggleable) --------------------------------------
# Master switch. `false` (or absent) ⇒ provable zero-egress OCR-only path. With it
# false, no provider SDK is imported and no client is constructed — the egress proof.
LLM_ENABLED=false
# One of: openai | google | anthropic | local. Only read when LLM_ENABLED=true.
# `local` is a zero-egress localhost server (Ollama/vLLM) and needs no API key.
LLM_PROVIDER=
# Override base URL for an in-firewall / internal model endpoint. In the POC, leave
# blank to reach the provider's cloud API; in production, point at the internal one.
LLM_BASE_URL=
# Active model id. Absent ⇒ a sensible per-provider default; the demo/benchmark sets
# it explicitly (e.g. gpt-4o-mini, claude-opus-4-8, gemini-2.0-flash).
LLM_MODEL_ID=
# Per-provider API keys. Only the SELECTED provider's key is needed; absent ⇒ that
# provider's model layer is simply off (OCR-only still works). NEVER logged.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Tracing (Epic 5, local-only) -------------------------------------------
# LangChain tracing is local-only and never egresses (no LangSmith/cloud endpoint
# is configured). Absent ⇒ off. Story 2.5 ships the toggle; the full local tracing
# harness is Epic 5 — 2.5 introduces NO tracing egress.
LANGCHAIN_TRACING_ENABLED=false

# --- Database (Story 1.2; Railway Volume in 1.6) ----------------------------
# SQLite file path. Absent or empty ⇒ default `data/app.db`. On Railway this is
# set to `/data/app.db` — a file inside the mounted Volume — so data survives
# redeploys (the container FS is ephemeral). See docs/railway-deployment.md.
DATABASE_PATH=

# --- Background sweep / pipeline (Story 2.2) --------------------------------
# In-process APScheduler sweep that pre-computes submissions. All in-process,
# zero egress. Absent ⇒ safe defaults (shown). `false` disables the live sweep
# entirely (e.g. a static demo or the test harness).
SCHEDULER_ENABLED=true
# How often the sweep ticks, in seconds.
SWEEP_INTERVAL_SECONDS=5
# Bounded worker pool — the concurrency ceiling that keeps the read path
# responsive (never an unbounded fan-out).
PIPELINE_MAX_WORKERS=2
# Max RECEIVED submissions claimed per tick (oldest-first).
PIPELINE_BATCH_SIZE=10

# --- Generated images (Story 2.3) -------------------------------------------
# Root for DERIVED OpenCV variants (enhanced/binarized). Purgeable directory on
# the Railway Volume; absent or empty ⇒ default `data/generated` (gitignored,
# beside the SQLite file). Seeded fixtures stay read-only — only variants land here.
GENERATED_IMAGES_DIR=

# --- OCR pass selection (perf toggle) ---------------------------------------
# The pipeline OCRs each image with every engine in OCR_ENGINES, on the ORIGINAL and
# (when OCR_PREPROCESS_VARIANTS=true) that engine's preprocessed variant. Fewer engines
# / no variants = fewer (slow) OCR passes. Defaults run the full matrix (both engines +
# variants) so the benchmark bake-off is complete; trim for speed.
#   OCR_ENGINES=paddleocr            # PaddleOCR only (drop Tesseract)
#   OCR_PREPROCESS_VARIANTS=false    # original image only (drop the variant passes)
OCR_ENGINES=tesseract,paddleocr
OCR_PREPROCESS_VARIANTS=true

# OCR feature toggle. OCR_ENABLED=false skips the OCR stage entirely (no engines run); the
# review cards then show only the AI reading (requires LLM_ENABLED=true). Defaults ON — the
# zero-egress baseline. With BOTH OCR_ENABLED and LLM_ENABLED on, each comparison card shows
# an OCR row AND an AI row side by side (the OCR-vs-AI head-to-head display).
OCR_ENABLED=true
