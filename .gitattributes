# Normalize line endings: store LF in the repo and check out LF everywhere.
# This stops the CRLF<->LF churn caused by core.autocrlf on Windows.
* text=auto eol=lf

# Explicit text types
*.md     text eol=lf
*.py     text eol=lf
*.toml   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.csv    text eol=lf
*.txt    text eol=lf

# Windows-specific scripts keep CRLF
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary assets — never touch line endings
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
